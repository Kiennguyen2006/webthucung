@model thucung.Models.KhachhangModel

@{
    Layout = null;
}

<style>
    * {
        box-sizing: border-box;
    }

    .khachhang-page {
        min-height: 100vh;
        padding: 25px;
        background: #fffdf5;
        font-family: Arial, Helvetica, sans-serif;
        color: #3f3f3f;
    }

    .khachhang-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .khachhang-title {
        margin: 0;
        color: #5d4037;
        font-size: 28px;
        font-weight: bold;
    }

    .khachhang-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn-back {
        background: #8d6e63;
        color: white;
    }

    .btn-edit {
        background: #f4b942;
        color: white;
    }

    .form-box {
        width: 100%;
        background: white;
        padding: 25px;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-group.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: #5d4037;
        font-size: 14px;
        font-weight: bold;
    }

    .form-value {
        width: 100%;
        min-height: 42px;
        padding: 11px 13px;
        border: 1px solid #eee;
        border-radius: 9px;
        background: #fffdf8;
        font-size: 14px;
        color: #3f3f3f;
    }

    .ma-khachhang {
        color: #8d6e63;
        font-weight: bold;
    }

    .ghi-chu {
        min-height: 100px;
        white-space: pre-wrap;
    }

    .thong-tin {
        margin-bottom: 20px;
        padding: 14px 18px;
        background: #fffaf0;
        border-radius: 10px;
        color: #8d6e63;
        font-size: 14px;
    }

    .form-submit {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
    }

    .empty-data {
        padding: 50px 20px;
        text-align: center;
        color: #888;
        font-size: 15px;
    }

    @@media (max-width: 700px) {
        .khachhang-page {
            padding: 15px;
        }

        .khachhang-title {
            font-size: 23px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .form-submit {
            flex-direction: column;
        }

        .form-submit .btn {
            width: 100%;
        }
    }
</style>

<div class="khachhang-page">

    <div class="khachhang-header">
        <h2 class="khachhang-title">
            <span>👤</span> Chi tiết khách hàng
        </h2>

        <div class="khachhang-actions">
            <a href="@Url.Action("Khachhang", "Quanly")" class="btn btn-back">
                ← Quay lại
            </a>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="form-box">

            <div class="thong-tin">
                👤 Thông tin chi tiết của khách hàng <strong>@Model.MaKhachHang</strong>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label>Mã khách hàng</label>

                    <div class="form-value ma-khachhang">
                        @Model.MaKhachHang
                    </div>
                </div>

                <div class="form-group">
                    <label>Họ tên</label>

                    <div class="form-value">
                        @Model.HoTen
                    </div>
                </div>

                <div class="form-group">
                    <label>Giới tính</label>

                    <div class="form-value">
                        @Model.GioiTinh
                    </div>
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>

                    <div class="form-value">
                        @Model.SoDienThoai
                    </div>
                </div>

                <div class="form-group">
                    <label>Email</label>

                    <div class="form-value">
                        @Model.Email
                    </div>
                </div>

                <div class="form-group">
                    <label>Ngày tạo</label>

                    <div class="form-value">
                        @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="form-group full">
                    <label>Địa chỉ</label>

                    <div class="form-value">
                        @Model.DiaChi
                    </div>
                </div>

                <div class="form-group full">
                    <label>Ghi chú</label>

                    <div class="form-value ghi-chu">
                        @Model.GhiChu
                    </div>
                </div>

            </div>

            <div class="form-submit">

                <a href="@Url.Action("Khachhang", "Quanly")" class="btn btn-back">
                    ← Quay lại
                </a>

                <a href="@Url.Action("Suakhachhang", "Quanly", new { id = Model.MaKhachHang })"
                   class="btn btn-edit">
                    ✏ Sửa thông tin
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="form-box">
            <div class="empty-data">
                Không tìm thấy thông tin khách hàng
            </div>
        </div>
    }

</div>