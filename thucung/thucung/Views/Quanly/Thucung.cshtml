@{
    Layout = null;
    ViewData["Title"] = "Quản lý thú cưng";
}

<style>

    .pet-page {
        width: 100%;
    }


    .pet-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }


    .pet-title-box {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    .pet-title-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: linear-gradient( 135deg, #5429b8, #8051e8 );
        color: white;
        font-size: 27px;
        box-shadow: 0 7px 18px rgba(84, 41, 184, 0.22);
    }


    .pet-title {
        margin: 0;
        font-size: 27px;
        font-weight: 800;
        color: #29243a;
    }


    .pet-subtitle {
        margin-top: 5px;
        color: #999;
        font-size: 14px;
    }


    .pet-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 19px;
        border-radius: 12px;
        background: linear-gradient( 135deg, #5429b8, #743be0 );
        color: white;
        text-decoration: none;
        font-weight: bold;
        box-shadow: 0 7px 18px rgba(84, 41, 184, 0.2);
        transition: 0.2s;
    }


        .pet-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(84, 41, 184, 0.28);
            color: white;
        }


    .pet-search-box {
        padding: 18px;
        margin-bottom: 22px;
        background: white;
        border: 1px solid #eee;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.04);
    }


    .pet-search-form {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .pet-search-input {
        flex: 1;
        min-width: 0;
        height: 43px;
        padding: 0 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        outline: none;
        font-size: 14px;
    }


        .pet-search-input:focus {
            border-color: #5429b8;
            box-shadow: 0 0 0 3px rgba(84,41,184,0.08);
        }


    .pet-search-button {
        height: 43px;
        padding: 0 18px;
        border: none;
        border-radius: 10px;
        background: #5429b8;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }


    .pet-refresh {
        height: 43px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f2f2f5;
        color: #555;
        text-decoration: none;
        font-weight: 600;
    }


        .pet-refresh:hover {
            background: #e8e8ee;
            color: #333;
        }


    .pet-table-box {
        background: white;
        border-radius: 17px;
        border: 1px solid #eee;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0,0,0,0.04);
    }


    .pet-table {
        width: 100%;
        border-collapse: collapse;
    }


        .pet-table th {
            padding: 15px 14px;
            background: #f8f7fc;
            color: #666;
            font-size: 13px;
            text-align: left;
            white-space: nowrap;
        }


        .pet-table td {
            padding: 14px;
            border-top: 1px solid #f0f0f0;
            color: #555;
            font-size: 14px;
            vertical-align: middle;
        }


        .pet-table tr:hover td {
            background: #fcfbff;
        }


    .pet-image {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 13px;
        border: 1px solid #eee;
        background: #f7f7f7;
    }


    .pet-no-image {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #f4efff;
        font-size: 25px;
    }


    .pet-name {
        font-weight: bold;
        color: #29243a;
    }


    .pet-code {
        margin-top: 4px;
        color: #999;
        font-size: 12px;
    }



    .pet-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }


    .pet-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 35px;
        padding: 0 9px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }


    .pet-detail {
        background: #eef5ff;
        color: #2874d0;
    }


    .pet-edit {
        background: #fff6df;
        color: #bd7b00;
    }


    .pet-delete {
        background: #fff0f0;
        color: #d64545;
    }


    .pet-action:hover {
        filter: brightness(0.95);
    }



    .pet-empty {
        padding: 65px 20px;
        text-align: center;
        color: #888;
    }


    .pet-empty-icon {
        font-size: 55px;
        margin-bottom: 12px;
    }


    .pet-empty-title {
        font-size: 18px;
        font-weight: bold;
        color: #555;
    }


    .pet-empty-text {
        margin-top: 7px;
        font-size: 14px;
    }


    @@media(max-width: 900px) {

        .pet-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .pet-search-form {
            flex-wrap: wrap;
        }

        .pet-search-input {
            width: 100%;
            flex-basis: 100%;
        }

        .pet-table-box {
            overflow-x: auto;
        }

        .pet-table {
            min-width: 900px;
        }
    }

</style>


<div class="pet-page">


    <div class="pet-top">

        <div class="pet-title-box">

            <div class="pet-title-icon">
                🐾
            </div>

            <div>

                <h1 class="pet-title">
                    Quản lý thú cưng
                </h1>

                <div class="pet-subtitle">
                    Quản lý thông tin các thú cưng của khách hàng
                </div>

            </div>

        </div>


        <a href="@Url.Action("Themthucung", "Quanly")"
           class="pet-add">

            ＋ Thêm thú cưng

        </a>

    </div>

    <div class="pet-search-box">

        <form method="get"
              action="@Url.Action("Thucung", "Quanly")"
              class="pet-search-form">

            <input type="text"
                   name="timkiem"
                   value="@Context.Request.Query["timkiem"]"
                   class="pet-search-input"
                   placeholder="Nhập mã hoặc tên thú cưng cần tìm..." />


            <button type="submit"
                    class="pet-search-button">

                🔍 Tìm kiếm

            </button>


            <a href="@Url.Action("Thucung", "Quanly")"
               class="pet-refresh">

                ↻ Làm mới

            </a>

        </form>

    </div>


    <div class="pet-table-box">

        @if (ViewBag.bangthucung != null &&
             ViewBag.bangthucung.Count > 0)
        {

            <table class="pet-table">

                <thead>

                    <tr>

                        <th>
                            Ảnh
                        </th>

                        <th>
                            Thú cưng
                        </th>

                        <th>
                            Loài
                        </th>

                        <th>
                            Giống
                        </th>

                        <th>
                            Giới tính
                        </th>

                        <th>
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in ViewBag.bangthucung)
                    {

                        <tr>
                            <td>

                                @if (item.Anh != null &&
                                     item.Anh != "")
                                {

                                    <img src="/images/@item.Anh"
                                         class="pet-image"
                                         alt="Ảnh thú cưng" />

                                }
                                else
                                {

                                    <div class="pet-no-image">
                                        🐾
                                    </div>

                                }

                            </td>

                            <td>

                                <div class="pet-name">
                                    @item.TenThuCung
                                </div>

                                <div class="pet-code">
                                    Mã: @item.MaThuCung
                                </div>

                            </td>

                            <td>
                                @item.LoaiThuCung
                            </td>

                            <td>
                                @item.GiongThuCung
                            </td>

                            <td>
                                @item.GioiTinh
                            </td>

                            <td>

                                <div class="pet-actions">


                                    <a href="@Url.Action("Chitiet", "Quanly", new { id = item.MaThuCung })"
                                       class="pet-action pet-detail">

                                        👁 Xem

                                    </a>


                                    <a href="@Url.Action("Sua", "Quanly", new { id = item.MaThuCung })"
                                       class="pet-action pet-edit">

                                        ✏ Sửa

                                    </a>


                                    <a href="@Url.Action("Xoa", "Quanly", new { id = item.MaThuCung })"
                                       class="pet-action pet-delete">

                                        🗑 Xóa

                                    </a>

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        }
        else
        {

            <div class="pet-empty">

                <div class="pet-empty-icon">
                    🐕
                </div>

                <div class="pet-empty-title">
                    Chưa có thú cưng
                </div>

                <div class="pet-empty-text">
                    Hãy thêm thú cưng đầu tiên vào hệ thống.
                </div>

            </div>

        }

    </div>

</div>