@model thucung.Models.ThuocModel

@{
    Layout = null;
}

<style>
    * {
        box-sizing: border-box;
    }

    .chi-tiet-thuoc-page {
        width: 100%;
        min-height: 100%;
        padding: 30px;
        background: #fffdf5;
        font-family: Arial, Helvetica, sans-serif;
        color: #3f3f3f;
    }

    .chi-tiet-header {
        margin-bottom: 25px;
    }

    .chi-tiet-header h2 {
        margin: 0 0 7px 0;
        font-size: 26px;
    }

    .chi-tiet-header p {
        margin: 0;
        font-size: 14px;
        color: #777;
    }

    .detail-box {
        width: 100%;
        max-width: 850px;
        background: white;
        padding: 28px;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .detail-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .detail-group {
        display: flex;
        flex-direction: column;
    }

    .detail-group-full {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
    }

    .detail-label {
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: bold;
        color: #4a4a4a;
    }

    .detail-value {
        min-height: 42px;
        padding: 11px 13px;
        border: 1px solid #eee;
        border-radius: 9px;
        background: #fafafa;
        font-size: 14px;
        color: #3f3f3f;
    }

    .detail-value.description {
        min-height: 100px;
        white-space: pre-wrap;
    }

    .status {
        font-weight: bold;
    }

    .form-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 9px;
        background: #f4c542;
        color: #3f3f3f;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        transition: 0.2s;
    }

    .btn-edit:hover {
        opacity: 0.85;
        transform: translateY(-1px);
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 9px;
        background: #eeeeee;
        color: #444;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        transition: 0.2s;
    }

    .btn-back:hover {
        background: #e2e2e2;
    }

    @@media (max-width: 700px) {
        .chi-tiet-thuoc-page {
            padding: 20px;
        }

        .detail-row {
            grid-template-columns: 1fr;
        }

        .detail-box {
            padding: 20px;
        }
    }
</style>

<div class="chi-tiet-thuoc-page">

    <div class="chi-tiet-header">
        <h2>💊 Chi tiết thuốc</h2>
        <p>Thông tin đầy đủ của thuốc</p>
    </div>

    <div class="detail-box">

        <div class="detail-row">

            <div class="detail-group">

                <div class="detail-label">
                    Mã thuốc
                </div>

                <div class="detail-value">
                    @Model?.MaThuoc
                </div>

            </div>

            <div class="detail-group">

                <div class="detail-label">
                    Tên thuốc
                </div>

                <div class="detail-value">
                    @Model?.TenThuoc
                </div>

            </div>

        </div>

        <div class="detail-row">

            <div class="detail-group">

                <div class="detail-label">
                    Đơn vị tính
                </div>

                <div class="detail-value">
                    @Model?.DonViTinh
                </div>

            </div>

            <div class="detail-group">

                <div class="detail-label">
                    Số lượng tồn
                </div>

                <div class="detail-value">
                    @Model?.SoLuongTon
                </div>

            </div>

        </div>

        <div class="detail-row">

            <div class="detail-group">

                <div class="detail-label">
                    Giá
                </div>

                <div class="detail-value">
                    @Model?.Gia.ToString("N0") VNĐ
                </div>

            </div>

            <div class="detail-group">

                <div class="detail-label">
                    Hạn sử dụng
                </div>

                <div class="detail-value">
                    @Model?.HanSuDung.ToString("dd/MM/yyyy")
                </div>

            </div>

        </div>

        <div class="detail-row">

            <div class="detail-group">

                <div class="detail-label">
                    Trạng thái
                </div>

                <div class="detail-value status">

                    @if (Model != null && Model.TrangThai)
                    {
                        <span>Đang sử dụng</span>
                    }
                    else
                    {
                        <span>Ngừng sử dụng</span>
                    }

                </div>

            </div>

            <div class="detail-group">
            </div>

        </div>

        <div class="detail-group-full">

            <div class="detail-label">
                Mô tả
            </div>

            <div class="detail-value description">
                @Model?.MoTa
            </div>

        </div>

        <div class="form-buttons">

            <a href="@Url.Action("Thuoc", "Quanly")"
               class="btn-back">
                ← Quay lại
            </a>

        </div>

    </div>

</div>