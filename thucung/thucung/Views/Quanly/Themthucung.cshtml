@model thucung.Models.ThucungModel

@{
    Layout = null;
    ViewData["Title"] = "Thêm thú cưng";
}

<style>

    .add-pet-page {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
    }

    .add-pet-header {

        display: flex;

        align-items: center;

        gap: 15px;

        margin-bottom: 25px;
    }


    .add-pet-icon {

        width: 55px;
        height: 55px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 17px;

        background: linear-gradient(
            135deg,
            #5429b8,
            #8051e8
        );

        color: white;

        font-size: 27px;

        box-shadow:
            0 7px 18px rgba(84, 41, 184, 0.22);
    }


    .add-pet-title {

        margin: 0;

        font-size: 27px;

        color: #29243a;

        font-weight: 800;
    }


    .add-pet-subtitle {

        margin-top: 5px;

        color: #999;

        font-size: 14px;
    }


    .pet-form-card {

        background: white;

        border: 1px solid #eee;

        border-radius: 18px;

        padding: 28px;

        box-shadow:
            0 7px 25px rgba(0,0,0,0.05);
    }


    .pet-form {

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 20px;
    }


    .pet-form-group {

        display: flex;

        flex-direction: column;

        gap: 7px;
    }


    .pet-form-group.full {

        grid-column: 1 / -1;
    }


    .pet-form-label {

        font-size: 14px;

        font-weight: 700;

        color: #444;
    }


    .pet-form-input,
    .pet-form-select,
    .pet-form-textarea {

        width: 100%;

        border: 1px solid #ddd;

        border-radius: 10px;

        padding: 11px 13px;

        outline: none;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 14px;

        background: white;
    }


    .pet-form-input,
    .pet-form-select {

        height: 43px;
    }


    .pet-form-textarea {

        min-height: 110px;

        resize: vertical;
    }


    .pet-form-input:focus,
    .pet-form-select:focus,
    .pet-form-textarea:focus {

        border-color: #5429b8;

        box-shadow:
            0 0 0 3px rgba(84,41,184,0.08);
    }


    .pet-form-required {

        color: #e33;

        margin-left: 3px;
    }


    .pet-form-error {

        color: #d33;

        font-size: 12px;
    }


    .pet-form-buttons {

        grid-column: 1 / -1;

        display: flex;

        justify-content: flex-end;

        align-items: center;

        gap: 10px;

        margin-top: 8px;

        padding-top: 20px;

        border-top: 1px solid #eee;
    }


    .pet-back-button {

        height: 43px;

        padding: 0 18px;

        border: none;

        border-radius: 10px;

        background: #f1f1f4;

        color: #555;

        font-weight: 600;

        cursor: pointer;
    }


    .pet-back-button:hover {

        background: #e7e7eb;
    }


    .pet-submit-button {

        height: 43px;

        padding: 0 21px;

        border: none;

        border-radius: 10px;

        background: linear-gradient(
            135deg,
            #5429b8,
            #743be0
        );

        color: white;

        font-weight: bold;

        cursor: pointer;

        box-shadow:
            0 6px 15px rgba(84,41,184,0.2);
    }


    .pet-submit-button:hover {

        transform: translateY(-1px);

        box-shadow:
            0 9px 18px rgba(84,41,184,0.25);
    }


    @@media(max-width: 700px) {

        .pet-form {

            grid-template-columns: 1fr;
        }

        .pet-form-group.full {

            grid-column: auto;
        }

        .pet-form-buttons {

            grid-column: auto;

            flex-direction: column;
        }

        .pet-back-button,
        .pet-submit-button {

            width: 100%;
        }

    }

</style>


<div class="add-pet-page">


    <div class="add-pet-header">

        <div class="add-pet-icon">
            🐾
        </div>

        <div>

            <h1 class="add-pet-title">
                Thêm thú cưng
            </h1>

            <div class="add-pet-subtitle">
                Nhập thông tin thú cưng vào hệ thống
            </div>

        </div>

    </div>


    <div class="pet-form-card">

        <form asp-action="Themtc"
              asp-controller="Quanly"
              method="post"
              enctype="multipart/form-data"
              class="pet-form">

            @Html.AntiForgeryToken()

            @{
                    if(ViewBag.tb!=""&& ViewBag.tb != null)
                    {
                        <p>@ViewBag.tb</p>
                    }
            }
            <div class="pet-form-group">

                <label class="pet-form-label">

                    Khách hàng
                    <span class="pet-form-required">*</span>

                </label>


               <select asp-for="MaKhachHang"
        class="pet-form-select">

    <option value="">
        -- Chọn khách hàng --
    </option>

    @if (ViewBag.thongtinkhachhang != null)
    {
        foreach (var kh in ViewBag.thongtinkhachhang)
        {
            <option value="@kh.MaKhachHang">
                @kh.HoTen
            </option>
        }
    }

</select>


                <span asp-validation-for="MaKhachHang"
                      class="pet-form-error">
                </span>

            </div>
            <div class="pet-form-group">

                <label class="pet-form-label">

                    Tên thú cưng
                    <span class="pet-form-required">*</span>

                </label>


                <input asp-for="TenThuCung"
                       class="pet-form-input"
                       placeholder="Ví dụ: Mimi" />


                <span asp-validation-for="TenThuCung"
                      class="pet-form-error">
                </span>

            </div>

            <div class="pet-form-group">

                <label class="pet-form-label">
                    Loài thú cưng
                </label>


                <input asp-for="LoaiThuCung"
                       class="pet-form-input"
                       placeholder="Ví dụ: Chó, Mèo..." />

            </div>


            <div class="pet-form-group">

                <label class="pet-form-label">
                    Giống
                </label>


                <input asp-for="GiongThuCung"
                       class="pet-form-input"
                       placeholder="Ví dụ: Poodle..." />

            </div>


            <div class="pet-form-group">

                <label class="pet-form-label">
                    Giới tính
                </label>


                <select asp-for="GioiTinh"
                        class="pet-form-select">

                    <option value="">
                        -- Chọn giới tính --
                    </option>

                    <option value="Đực">
                        Đực
                    </option>

                    <option value="Cái">
                        Cái
                    </option>

                </select>

            </div>


            <div class="pet-form-group">

                <label class="pet-form-label">
                    Màu lông
                </label>


                <input asp-for="MauLong"
                       class="pet-form-input"
                       placeholder="Ví dụ: Trắng, vàng..." />

            </div>


            <div class="pet-form-group">

                <label class="pet-form-label">
                    Cân nặng
                </label>


                <input asp-for="CanNang"
                       class="pet-form-input"
                       type="number"
                       step="0.1"
                       placeholder="Kg" />

            </div>


            <div class="pet-form-group">

                <label class="pet-form-label">
                    Ảnh
                </label>


                <input asp-for="Anh" type="file"
                       class="pet-form-input"
                       name="anhFile"
                       placeholder="Tên hoặc đường dẫn ảnh" />

            </div>

            <div class="pet-form-group full">

                <label class="pet-form-label">
                    Mô tả
                </label>


                <textarea asp-for="MoTa"
                          class="pet-form-textarea"
                          placeholder="Nhập thêm thông tin về thú cưng..."></textarea>

            </div>

            <div class="pet-form-buttons">


                <button type="button"
                        class="pet-back-button"
                        data-page="@Url.Action("Thucung", "Quanly")">

                    ← Quay lại

                </button>


                <button type="submit"
                        class="pet-submit-button">

                    ＋ Thêm thú cưng

                </button>


            </div>

        </form>

    </div>

</div>