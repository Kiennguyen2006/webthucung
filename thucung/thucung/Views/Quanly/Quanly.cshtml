@{
    ViewData["Title"] = "K.M.N.A PET";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #fffdf5;
        color: #3f3f3f;
    }

    .vet-page {
        min-height: 100vh;
        background: radial-gradient(circle at 5% 20%, rgba(255, 210, 70, 0.16), transparent 12%), radial-gradient(circle at 95% 65%, rgba(255, 210, 70, 0.16), transparent 12%), #fffdf7;
        position: relative;
        overflow: hidden;
    }

    .vet-header {
        height: 78px;
        background: linear-gradient(100deg, #ffe37a, #ffd25b, #f8e9a7);
        display: flex;
        align-items: center;
        padding: 0 30px;
        gap: 25px;
        box-shadow: 0 3px 15px rgba(180, 140, 40, 0.15);
        position: relative;
        z-index: 5;
    }

    .vet-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 310px;
    }

    .vet-logo-icon {
        width: 50px;
        height: 50px;
        background: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 27px;
        box-shadow: 0 4px 10px rgba(0,0,0,.08);
    }

    .vet-logo-title {
        font-size: 24px;
        font-weight: bold;
        color: #393939;
    }

    .vet-logo-sub {
        font-size: 12px;
        color: #75622e;
        margin-top: 3px;
    }

    .vet-search {
        height: 43px;
        width: 380px;
        background: white;
        border: 1px solid #ecd27b;
        border-radius: 25px;
        display: flex;
        align-items: center;
        padding: 0 17px;
    }

        .vet-search span {
            font-size: 18px;
            margin-right: 10px;
        }

        .vet-search input {
            width: 100%;
            border: none;
            outline: none;
            font-size: 14px;
        }

    .vet-header-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .vet-account {
        height: 48px;
        padding: 5px 15px;
        background: rgba(255,255,255,.8);
        border: 1px solid #d9af36;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        cursor: pointer;
    }

        .vet-account:hover {
            background: white;
        }

    .vet-clinic {
        background: white;
        border-radius: 25px;
        padding: 12px 17px;
        border: 1px solid #ead27b;
        font-size: 13px;
        white-space: nowrap;
    }

    .vet-body {
        display: flex;
        min-height: calc(100vh - 78px);
        position: relative;
        z-index: 2;
    }

    .vet-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: rgba(255,255,255,.96);
        border-right: 1px solid #eee2c1;
        padding: 25px 18px;
    }

    .vet-staff {
        text-align: center;
        padding-bottom: 20px;
    }

    .vet-staff-avatar {
        width: 75px;
        height: 75px;
        margin: auto;
        border-radius: 50%;
        background: #fff0bd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        border: 5px solid white;
        box-shadow: 0 5px 15px rgba(190,150,40,.15);
    }

    .vet-staff-name {
        margin-top: 10px;
        font-weight: bold;
        font-size: 16px;
    }

    .vet-staff-id {
        font-size: 12px;
        color: #888;
        margin-top: 5px;
    }

    .vet-menu {
        margin-top: 10px;
    }

    .vet-menu-item {
        height: 53px;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 0 14px;
        margin-bottom: 6px;
        border-radius: 13px;
        color: #555;
        text-decoration: none;
        transition: .2s;
        cursor: pointer;
    }

        .vet-menu-item:hover {
            background: #fff8dc;
            transform: translateX(3px);
        }

        .vet-menu-item.active {
            background: linear-gradient(90deg, #ffd65d, #ffe998);
            color: #624b13;
            font-weight: bold;
        }

    .vet-menu-icon {
        width: 25px;
        font-size: 20px;
    }

    .vet-side-decoration {
        height: 145px;
        margin-top: 30px;
        border-radius: 20px;
        background: linear-gradient(145deg, #fff8db, #ffedb1);
        position: relative;
        overflow: hidden;
        padding: 18px;
    }

    .vet-side-text {
        color: #a27416;
        font-weight: bold;
        font-size: 14px;
    }

    .vet-side-pet {
        position: absolute;
        right: -5px;
        bottom: -15px;
        font-size: 90px;
    }

    .vet-main {
        flex: 1;
        padding: 28px;
        min-width: 0;
    }

    .vet-content {
        background: rgba(255,255,255,.96);
        border: 1px solid #eee0bc;
        border-radius: 22px;
        padding: 25px;
        min-height: calc(100vh - 134px);
        box-shadow: 0 10px 35px rgba(150,110,30,.09);
    }

    .page-loading {
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 15px;
        color: #9a7b20;
        font-size: 16px;
    }

    .loading-icon {
        font-size: 42px;
        animation: loading 1s linear infinite;
    }

    .page-error {
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 12px;
        text-align: center;
    }

    .page-error-icon {
        font-size: 55px;
    }

    .page-error-title {
        font-size: 23px;
        font-weight: bold;
        color: #555;
    }

    .page-error-text {
        color: #888;
    }

    .vet-paw {
        position: fixed;
        z-index: 1;
        pointer-events: none;
        opacity: .17;
        font-size: 45px;
    }

    .paw-1 {
        left: 15px;
        top: 120px;
    }

    .paw-2 {
        right: 25px;
        top: 180px;
    }

    .paw-3 {
        right: 35px;
        bottom: 130px;
    }

    .paw-4 {
        left: 290px;
        bottom: 30px;
    }

    @@keyframes loading {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 1100px) {
        .vet-search {
            display: none;
        }
    }

    @@media (max-width: 800px) {
        .vet-header {
            padding: 10px 15px;
        }

        .vet-logo {
            min-width: auto;
        }

        .vet-logo-title {
            font-size: 19px;
        }

        .vet-logo-sub {
            display: none;
        }

        .vet-clinic {
            display: none;
        }

        .vet-body {
            display: block;
        }

        .vet-sidebar {
            width: 100%;
            border-right: none;
        }

        .vet-main {
            padding: 12px;
        }

        .vet-content {
            padding: 15px;
        }
    }
</style>

<div class="vet-page">

    <div class="vet-paw paw-1">🐾</div>
    <div class="vet-paw paw-2">🐾</div>
    <div class="vet-paw paw-3">🐾</div>
    <div class="vet-paw paw-4">🐾</div>

    <header class="vet-header">

        <div class="vet-logo">

            <div class="vet-logo-icon">
                🐾
            </div>

            <div>

                <div class="vet-logo-title">
                    K.M.N.A PET
                </div>

                <div class="vet-logo-sub">
                    Hệ thống quản lý thú cưng
                </div>

            </div>

        </div>

        <div class="vet-search">

            <span>🔍</span>

            <input type="text"
                   placeholder="Tìm kiếm nhanh..." />

        </div>

        <div class="vet-header-right">

            <button class="vet-account">

                👤

                <span>
                    Tài khoản<br />
                    @ViewBag.tentaikhoan
                </span>

                ▼

            </button>

            <div class="vet-clinic">
                🐶 Hệ thống quản lý
            </div>

        </div>

    </header>

    <div class="vet-body">

        <aside class="vet-sidebar">

            <div class="vet-staff">

                <div class="vet-staff-avatar">
                    🐕
                </div>

                <div class="vet-staff-name">
                    @ViewBag.tentaikhoan
                </div>

                <div class="vet-staff-id">
                    Tài khoản đang đăng nhập
                </div>

            </div>

            <nav class="vet-menu">

                <a href="@Url.Action("Thucung", "Quanly")"
                   class="vet-menu-item"
                   data-page="@Url.Action("Thucung", "Quanly")">

                    <span class="vet-menu-icon">
                        🐾
                    </span>

                    <span>
                        Thú cưng
                    </span>

                </a>

                <a href="@Url.Action("Index", "Khachhang")"
                   class="vet-menu-item"
                   data-page="@Url.Action("Index", "Khachhang")">

                    <span class="vet-menu-icon">
                        👥
                    </span>

                    <span>
                        Khách hàng
                    </span>

                </a>

                <a href="@Url.Action("Index", "Thuoc")"
                   class="vet-menu-item"
                   data-page="@Url.Action("Index", "Thuoc")">

                    <span class="vet-menu-icon">
                        💊
                    </span>

                    <span>
                        Thuốc
                    </span>

                </a>

                <a href="@Url.Action("Index", "Lichsu")"
                   class="vet-menu-item"
                   data-page="@Url.Action("Index", "Lichsu")">

                    <span class="vet-menu-icon">
                        📅
                    </span>

                    <span>
                        Lịch sử khám
                    </span>

                </a>

                @{
                    if (ViewBag.tentaikhoan != null &&
                        ViewBag.tentaikhoan.ToString().Equals("Chushop"))
                    {
                        <a href="@Url.Action("Index", "Nhanvien")"
                           class="vet-menu-item"
                           data-page="@Url.Action("Index", "Nhanvien")">

                            <span class="vet-menu-icon">
                                👨‍⚕️
                            </span>

                            <span>
                                Nhân viên
                            </span>

                        </a>

                        <a href="@Url.Action("Index", "Taikhoan")"
                           class="vet-menu-item"
                           data-page="@Url.Action("Index", "Taikhoan")">

                            <span class="vet-menu-icon">
                                📊
                            </span>

                            <span>
                                Tài khoản
                            </span>

                        </a>
                    }
                }

            </nav>

            <div class="vet-side-decoration">

                <div class="vet-side-text">
                    Thú cưng<br />
                    là gia đình ❤️
                </div>

                <div class="vet-side-pet">
                    🐶
                </div>

            </div>

        </aside>

        <main class="vet-main">

            <div class="vet-content" id="page-content">
            </div>

        </main>

    </div>

</div>
<script>
document.addEventListener("DOMContentLoaded", function () {
var menuItems = document.querySelectorAll(".vet-menu-item");
var content = document.getElementById("page-content");

function loadPage(url) {
content.innerHTML = "";

fetch(url)
.then(function (response) {
if (!response.ok) {
throw new Error("Không thể tải trang");
}

return response.text();
})
.then(function (html) {
content.innerHTML = html;
bindSearchForm();
})
.catch(function () {
content.innerHTML = `
<div class="page-error">
    <div class="page-error-icon">😿</div>
    <div class="page-error-title">Không thể tải trang</div>
</div>
`;
});
}

function bindSearchForm() {
var searchForm = document.querySelector(".pet-search-form");

if (searchForm == null) {
return;
}

searchForm.addEventListener("submit", function (event) {
event.preventDefault();

var formData = new FormData(searchForm);
var params = new URLSearchParams(formData);

var url = searchForm.action + "?" + params.toString();

loadPage(url);
});
}

menuItems.forEach(function (item) {
item.addEventListener("click", function (event) {
event.preventDefault();

var url = item.getAttribute("data-page");

if (url == null || url == "") {
return;
}

menuItems.forEach(function (menu) {
menu.classList.remove("active");
});

item.classList.add("active");

loadPage(url);
});
});
});
</script>