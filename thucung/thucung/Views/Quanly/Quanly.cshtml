```cshtml
@{
    ViewData["Title"] = "K.M.N.A PET";
}

<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        font-family: Arial, Helvetica, sans-serif;
        background: #fffdf5;
        color: #3f3f3f;
    }

    .vet-page {
        min-height: 100vh;
        background: #fffdf5;
    }

    .vet-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 78px;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 30px;
        background: linear-gradient(135deg, #17172f, #32166d, #5429b8);
        color: white;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
    }

    .vet-logo {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .vet-logo-icon {
        width: 45px;
        height: 45px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.15);
        font-size: 25px;
    }

    .vet-logo-text {
        font-size: 23px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .vet-header-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .vet-clinic {
        padding: 9px 15px;
        border-radius: 12px;
        background: rgba(255,255,255,0.1);
        font-size: 14px;
    }

    .vet-account {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        border-radius: 13px;
        background: rgba(255,255,255,0.13);
    }

    .vet-account-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: white;
        color: #5429b8;
        font-weight: bold;
    }

    .vet-account-name {
        font-weight: 600;
    }

    .vet-sidebar {
        position: fixed;
        top: 78px;
        left: 0;
        bottom: 0;
        width: 245px;
        padding: 22px 15px;
        background: white;
        border-right: 1px solid #eee;
        box-shadow: 3px 0 15px rgba(0,0,0,0.05);
        overflow-y: auto;
        z-index: 900;
    }

    .vet-menu-title {
        padding: 5px 12px 14px;
        color: #999;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .vet-menu {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .vet-menu-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        border-radius: 13px;
        color: #555;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .vet-menu-item:hover {
            background: #f4efff;
            color: #5429b8;
        }

        .vet-menu-item.active {
            background: linear-gradient(135deg, #5429b8, #743be0);
            color: white;
            box-shadow: 0 6px 16px rgba(84, 41, 184, 0.25);
        }

    .vet-menu-icon {
        width: 25px;
        text-align: center;
        font-size: 19px;
    }

    .vet-menu-line {
        height: 1px;
        background: #eee;
        margin: 13px 5px;
    }

    .vet-main {
        margin-left: 245px;
        padding-top: 78px;
        min-height: 100vh;
    }

    .vet-content {
        padding: 28px;
        min-height: calc(100vh - 78px);
    }

    .page-loading {
        min-height: 450px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #777;
    }

    .loading-icon {
        font-size: 48px;
        margin-bottom: 15px;
        animation: loading 1s infinite alternate;
    }

    @@keyframes loading {
        from {
            transform: translateY(0);
        }

        to {
            transform: translateY(-8px);
        }
    }

    .page-error {
        min-height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .page-error-icon {
        font-size: 50px;
        margin-bottom: 12px;
    }

    .page-error-title {
        font-size: 21px;
        font-weight: bold;
        color: #555;
    }

    .page-error-text {
        margin-top: 8px;
        color: #888;
    }

    @@media(max-width: 850px) {
        .vet-sidebar {
            width: 200px;
        }

        .vet-main {
            margin-left: 200px;
        }

        .vet-header-right {
            display: none;
        }
    }

    @@media(max-width: 650px) {
        .vet-sidebar {
            position: relative;
            top: 0;
            width: 100%;
            height: auto;
        }

        .vet-main {
            margin-left: 0;
            padding-top: 0;
        }

        .vet-header {
            position: relative;
        }

        .vet-content {
            padding: 15px;
        }
    }
</style>

<div class="vet-page">

    <header class="vet-header">

        <div class="vet-logo">

            <div class="vet-logo-icon">
                🐾
            </div>

            <div class="vet-logo-text">
                K.M.N.A PET
            </div>

        </div>

        <div class="vet-header-right">

            <div class="vet-clinic">
                🏥 Hệ thống quản lý thú cưng
            </div>

            <div class="vet-account">

                <div class="vet-account-icon">
                    👤
                </div>

                <div class="vet-account-name">
                    @ViewBag.tentaikhoan
                </div>

            </div>

        </div>

    </header>

 
    <aside class="vet-sidebar">

        <div class="vet-menu-title">
            QUẢN LÝ
        </div>

        <nav class="vet-menu">

            <a href="@Url.Action("Thucung", "Quanly")"
               class="vet-menu-item"
               data-page="@Url.Action("Thucung", "Quanly")">

                <span class="vet-menu-icon">🐾</span>

                <span>
                    Thú cưng
                </span>

            </a>

 
            <a href="@Url.Action("Khachhang", "Quanly")"
               class="vet-menu-item"
               data-page="@Url.Action("Khachhang", "Quanly")">

                <span class="vet-menu-icon">👥</span>

                <span>
                    Khách hàng
                </span>

            </a>

 
            <a href="@Url.Action("Phieukham", "Quanly")"
               class="vet-menu-item"
               data-page="@Url.Action("Phieukham", "Quanly")">

                <span class="vet-menu-icon">📋</span>

                <span>
                    Phiếu khám
                </span>

            </a>

 
            <a href="@Url.Action("HoaDon", "Quanly")"
               class="vet-menu-item"
               data-page="@Url.Action("HoaDon", "Quanly")">

                <span class="vet-menu-icon">🧾</span>

                <span>
                    Hóa đơn
                </span>

            </a>

 
            <a href="@Url.Action("Thuoc", "Quanly")"
               class="vet-menu-item"
               data-page="@Url.Action("Thuoc", "Quanly")">

                <span class="vet-menu-icon">💊</span>

                <span>
                    Thuốc
                </span>

            </a>

 
            @if (ViewBag.phanquyen == "ChuShop")
            {
                <div class="vet-menu-line"></div>

                <div class="vet-menu-title">
                    HỆ THỐNG
                </div>

 
                <a href="@Url.Action("Nhanvien", "Quanly")"
                   class="vet-menu-item"
                   data-page="@Url.Action("Nhanvien", "Quanly")">

                    <span class="vet-menu-icon">👨‍⚕️</span>

                    <span>
                        Nhân viên
                    </span>

                </a>

 
                <a href="@Url.Action("TaiKhoan", "Quanly")"
                   class="vet-menu-item"
                   data-page="@Url.Action("TaiKhoan", "Quanly")">

                    <span class="vet-menu-icon">🔐</span>

                    <span>
                        Tài khoản
                    </span>

                </a>
            }

        </nav>

    </aside>

 
    <main class="vet-main">

        <div class="vet-content" id="page-content">

            <div class="page-loading">

                <div class="loading-icon">
                    🐾
                </div>

                <div>
                    Đang tải dữ liệu...
                </div>

            </div>

        </div>

    </main>

</div>

 
<script>

 
    document.addEventListener("DOMContentLoaded", function () {

        var menuItems = document.querySelectorAll(".vet-menu-item");
        var content = document.getElementById("page-content");

 
        function loadPage(url) {

            if (url == null || url == "") {
                return;
            }

 
            content.innerHTML = `
                <div class="page-loading">
                    <div class="loading-icon">🐾</div>
                    <div>Đang tải dữ liệu...</div>
                </div>
            `;

 
            fetch(url)
                .then(function (response) {

                    if (!response.ok) {
                        throw new Error("Không thể tải trang");
                    }

                    return response.text();

                })
                .then(function (html) {

                    content.innerHTML = html;

                })
                .catch(function () {

                    content.innerHTML = `
                        <div class="page-error">

                            <div class="page-error-icon">
                                😿
                            </div>

                            <div class="page-error-title">
                                Không thể tải trang
                            </div>

                            <div class="page-error-text">
                                Vui lòng thử lại.
                            </div>

                        </div>
                    `;

                });

        }

 
        menuItems.forEach(function (item) {

            item.addEventListener("click", function (event) {

                event.preventDefault();

                var url = item.getAttribute("data-page");

                if (url == null || url == "") {
                    return;
                }

 
                menuItems.forEach(function (menu) {

                    menu.classList.remove("active");

                });

 
                item.classList.add("active");

                loadPage(url);

            });

        });

 
        content.addEventListener("click", function (event) {

            var link = event.target.closest("a");

            if (link == null) {
                return;
            }

 
            var url = link.getAttribute("href");

 
            if (url == null || url == "" || url == "#") {
                return;
            }

 
            if (link.target == "_blank") {
                return;
            }

 
            event.preventDefault();

 
            loadPage(url);

        });

 
        content.addEventListener("click", function (event) {

            var button = event.target.closest("[data-page]");

            if (button == null) {
                return;
            }

 
            var url = button.getAttribute("data-page");

            if (url == null || url == "") {
                return;
            }

 
            event.preventDefault();

            loadPage(url);

        });

 
        content.addEventListener("submit", function (event) {

            var form = event.target;

 
            if (form.tagName.toLowerCase() != "form") {
                return;
            }

 
            event.preventDefault();

 
            var method = form.method;

            if (method == null || method == "") {
                method = "get";
            }

            method = method.toLowerCase();

 
            var url = form.action;

 
            if (url == null || url == "") {
                url = window.location.href;
            }

 
            var formData = new FormData(form);

 
            if (method == "get") {

                var params = new URLSearchParams(formData);

                if (params.toString() != "") {

                    if (url.indexOf("?") >= 0) {

                        url = url + "&" + params.toString();

                    }
                    else {

                        url = url + "?" + params.toString();

                    }

                }

 
                loadPage(url);

                return;
            }

 
            content.innerHTML = `
                <div class="page-loading">

                    <div class="loading-icon">
                        🐾
                    </div>

                    <div>
                        Đang lưu dữ liệu...
                    </div>

                </div>
            `;

 
            fetch(url, {
                method: "POST",
                body: formData
            })
                .then(function (response) {

                    if (!response.ok) {
                        throw new Error("Không thể lưu dữ liệu");
                    }

                    return response.text();

                })
                .then(function (html) {

                    content.innerHTML = html;

                })
                .catch(function () {

                    content.innerHTML = `
                        <div class="page-error">

                            <div class="page-error-icon">
                                😿
                            </div>

                            <div class="page-error-title">
                                Không thể lưu dữ liệu
                            </div>

                            <div class="page-error-text">
                                Vui lòng kiểm tra lại thông tin.
                            </div>

                        </div>
                    `;

                });

        });

        var firstPetPage =
            document.querySelector(
                '.vet-menu-item[data-page*="Thucung"]'
            );

 
        if (firstPetPage != null) {

            firstPetPage.classList.add("active");

            var firstUrl =
                firstPetPage.getAttribute("data-page");

 
            if (firstUrl != null && firstUrl != "") {

                loadPage(firstUrl);

            }

        }

    });

</script>
```
