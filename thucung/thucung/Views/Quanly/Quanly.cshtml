@{
}
@{
    ViewData["Title"] = "K.M.N.A PET";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #fffdf5;
        color: #3f3f3f;
    }

    .vet-page {
        min-height: 100vh;
        background:
            radial-gradient(circle at 5% 20%, rgba(255, 210, 70, 0.16), transparent 12%),
            radial-gradient(circle at 95% 65%, rgba(255, 210, 70, 0.16), transparent 12%),
            #fffdf7;
        position: relative;
        overflow: hidden;
    }

    .vet-header {
        height: 78px;
        background: linear-gradient(100deg, #ffe37a, #ffd25b, #f8e9a7);
        display: flex;
        align-items: center;
        padding: 0 30px;
        gap: 25px;
        box-shadow: 0 3px 15px rgba(180, 140, 40, 0.15);
        position: relative;
        z-index: 5;
    }

    .vet-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 310px;
    }

    .vet-logo-icon {
        width: 50px;
        height: 50px;
        background: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 27px;
        box-shadow: 0 4px 10px rgba(0,0,0,.08);
    }

    .vet-logo-title {
        font-size: 24px;
        font-weight: bold;
        color: #393939;
    }

    .vet-logo-sub {
        font-size: 12px;
        color: #75622e;
        margin-top: 3px;
    }

    .vet-search {
        height: 43px;
        width: 380px;
        background: white;
        border: 1px solid #ecd27b;
        border-radius: 25px;
        display: flex;
        align-items: center;
        padding: 0 17px;
    }

    .vet-search span {
        font-size: 18px;
        margin-right: 10px;
    }

    .vet-search input {
        width: 100%;
        border: none;
        outline: none;
        font-size: 14px;
    }

    .vet-header-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .vet-account {
        height: 48px;
        padding: 5px 15px;
        background: rgba(255,255,255,.8);
        border: 1px solid #d9af36;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
    }

    .vet-clinic {
        background: white;
        border-radius: 25px;
        padding: 12px 17px;
        border: 1px solid #ead27b;
        font-size: 13px;
        white-space: nowrap;
    }


    .vet-body {
        display: flex;
        min-height: calc(100vh - 78px);
        position: relative;
        z-index: 2;
    }

    .vet-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: rgba(255,255,255,.94);
        border-right: 1px solid #eee2c1;
        padding: 25px 18px;
    }

    .vet-staff {
        text-align: center;
        padding-bottom: 20px;
    }

    .vet-staff-avatar {
        width: 75px;
        height: 75px;
        margin: auto;
        border-radius: 50%;
        background: #fff0bd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        border: 5px solid white;
        box-shadow: 0 5px 15px rgba(190,150,40,.15);
    }

    .vet-staff-name {
        margin-top: 10px;
        font-weight: bold;
        font-size: 16px;
    }

    .vet-staff-id {
        font-size: 12px;
        color: #888;
        margin-top: 5px;
    }

    .vet-menu {
        margin-top: 10px;
    }

    .vet-menu-item {
        height: 53px;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 0 14px;
        margin-bottom: 6px;
        border-radius: 13px;
        color: #555;
        text-decoration: none;
        transition: .2s;
    }

    .vet-menu-item:hover {
        background: #fff8dc;
        transform: translateX(3px);
    }

    .vet-menu-item.active {
        background: linear-gradient(90deg, #ffd65d, #ffe998);
        color: #624b13;
        font-weight: bold;
    }

    .vet-menu-icon {
        width: 25px;
        font-size: 20px;
    }

    .vet-side-decoration {
        height: 145px;
        margin-top: 30px;
        border-radius: 20px;
        background: linear-gradient(145deg, #fff8db, #ffedb1);
        position: relative;
        overflow: hidden;
        padding: 18px;
    }

    .vet-side-text {
        color: #a27416;
        font-weight: bold;
        font-size: 14px;
    }

    .vet-side-pet {
        position: absolute;
        right: -5px;
        bottom: -15px;
        font-size: 90px;
    }

    .vet-main {
        flex: 1;
        padding: 28px;
        min-width: 0;
    }

    .vet-content {
        background: rgba(255,255,255,.96);
        border: 1px solid #eee0bc;
        border-radius: 22px;
        padding: 25px;
        box-shadow: 0 10px 35px rgba(150,110,30,.09);
        min-height: 650px;
    }


    .vet-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .vet-title {
        font-size: 28px;
        font-weight: bold;
        color: #333;
    }

    .vet-description {
        margin-top: 6px;
        color: #858585;
        font-size: 14px;
    }

    .vet-add-button {
        border: none;
        background: linear-gradient(135deg, #ffd65c, #ffbf2f);
        color: #60470d;
        padding: 14px 20px;
        border-radius: 12px;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 6px 15px rgba(235,170,30,.2);
    }

    .vet-filter {
        border: 1px solid #eee2c6;
        border-radius: 16px;
        background: #fffdf8;
        padding: 14px;
        display: grid;
        grid-template-columns: 1.3fr .8fr .9fr .8fr;
        gap: 10px;
        margin-bottom: 20px;
    }

    .vet-filter-box {
        height: 44px;
        background: white;
        border: 1px solid #e7ddc8;
        border-radius: 10px;
        display: flex;
        align-items: center;
        padding: 0 12px;
        color: #777;
        font-size: 14px;
    }

    .vet-table-box {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #eadfca;
        border-radius: 14px;
        background: white;
    }

    .vet-table {
        width: 100%;
        min-width: 1000px;
        border-collapse: collapse;
    }

    .vet-table th {
        height: 52px;
        background: #fff0bc;
        color: #5e4a17;
        font-size: 13px;
        border-right: 1px solid #eadfca;
        border-bottom: 1px solid #eadfca;
        text-align: center;
    }

    .vet-table td {
        height: 70px;
        border-right: 1px solid #eee8da;
        border-bottom: 1px solid #eee8da;
    }

    .vet-empty-row td {
        height: 100px;
        background: #fff;
    }


    .vet-paw {
        position: fixed;
        z-index: 1;
        pointer-events: none;
        opacity: .17;
        font-size: 45px;
    }

    .paw-1 {
        left: 15px;
        top: 120px;
    }

    .paw-2 {
        right: 25px;
        top: 180px;
    }

    .paw-3 {
        right: 35px;
        bottom: 130px;
    }

    .paw-4 {
        left: 290px;
        bottom: 30px;
    }

    .vet-bottom-decoration {
        height: 55px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 70px;
        color: #eebd42;
        font-size: 25px;
    }

    @@media (max-width: 1100px) {

        .vet-search {
            display: none;
        }

        .vet-filter {
            grid-template-columns: 1fr 1fr;
        }

    }

    @@media (max-width: 800px) {

        .vet-header {
            padding: 10px 15px;
        }

        .vet-logo {
            min-width: auto;
        }

        .vet-logo-title {
            font-size: 19px;
        }

        .vet-logo-sub {
            display: none;
        }

        .vet-clinic {
            display: none;
        }

        .vet-body {
            display: block;
        }

        .vet-sidebar {
            width: 100%;
            border-right: none;
        }

        .vet-main {
            padding: 12px;
        }

        .vet-title-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .vet-add-button {
            width: 100%;
        }

        .vet-filter {
            grid-template-columns: 1fr;
        }

        .vet-content {
            padding: 15px;
        }

    }
</style>


