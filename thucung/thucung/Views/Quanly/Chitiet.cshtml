@model thucung.Models.ThucungModel

@{
    Layout = null;
    ViewData["Title"] = "Chi tiết thú cưng";
}

<style>
    .pet-detail-page {
        padding: 25px;
        width: 100%;
    }

    .pet-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .pet-detail-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #4b3a22;
    }

    .pet-detail-subtitle {
        margin-top: 6px;
        color: #8b7a63;
        font-size: 14px;
    }

    .pet-back-button {
        border: none;
        background: #f5c84c;
        color: #4b3a22;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .pet-back-button:hover {
        background: #eab936;
        transform: translateY(-1px);
    }

    .pet-detail-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        display: flex;
        gap: 30px;
    }

    .pet-detail-image {
        width: 280px;
        min-width: 280px;
        height: 280px;
        border-radius: 16px;
        background: #fff8df;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .pet-detail-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .pet-no-image {
        font-size: 60px;
    }

    .pet-detail-info {
        flex: 1;
    }

    .pet-name {
        font-size: 26px;
        font-weight: 700;
        color: #4b3a22;
        margin-bottom: 20px;
    }

    .pet-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .pet-info-item {
        background: #fffdf5;
        border: 1px solid #f1e6c5;
        border-radius: 12px;
        padding: 14px 16px;
    }

    .pet-info-label {
        display: block;
        font-size: 13px;
        color: #9a8b73;
        margin-bottom: 5px;
    }

    .pet-info-value {
        font-size: 16px;
        font-weight: 600;
        color: #4b3a22;
        word-break: break-word;
    }

    .pet-description {
        margin-top: 15px;
        background: #fffdf5;
        border: 1px solid #f1e6c5;
        border-radius: 12px;
        padding: 15px 16px;
    }

    .pet-description-text {
        margin-top: 7px;
        color: #4b4b4b;
        line-height: 1.6;
    }

    @@media (max-width: 850px) {
        .pet-detail-card {
            flex-direction: column;
        }

        .pet-detail-image {
            width: 100%;
            min-width: 0;
        }

        .pet-info-grid {
            grid-template-columns: 1fr;
        }

        .pet-detail-header {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }
    }
</style>

<div class="pet-detail-page">

    <div class="pet-detail-header">
        <div>
            <h1 class="pet-detail-title">🐾 Chi tiết thú cưng</h1>
            <div class="pet-detail-subtitle">
                Xem thông tin đầy đủ của thú cưng
            </div>
        </div>

        <button type="button"
                class="pet-back-button"
                data-page="@Url.Action("Thucung", "Quanly")">
            ← Quay lại
        </button>
    </div>

    <div class="pet-detail-card">

        <div class="pet-detail-image">
            @if (!string.IsNullOrEmpty(Model.Anh))
            {
                <img src="~/images/@Model.Anh" alt="@Model.TenThuCung" />
            }
            else
            {
                <div class="pet-no-image">🐶</div>
            }
        </div>

        <div class="pet-detail-info">

            <div class="pet-name">
                🐾 @Model.TenThuCung
            </div>

            <div class="pet-info-grid">

                <div class="pet-info-item">
                    <span class="pet-info-label">Mã thú cưng</span>
                    <span class="pet-info-value">@Model.MaThuCung</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Mã khách hàng</span>
                    <span class="pet-info-value">@Model.MaKhachHang</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Loài thú cưng</span>
                    <span class="pet-info-value">@Model.LoaiThuCung</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Giống</span>
                    <span class="pet-info-value">@Model.GiongThuCung</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Giới tính</span>
                    <span class="pet-info-value">@Model.GioiTinh</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Màu lông</span>
                    <span class="pet-info-value">@Model.MauLong</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Cân nặng</span>
                    <span class="pet-info-value">@Model.CanNang kg</span>
                </div>

                <div class="pet-info-item">
                    <span class="pet-info-label">Ngày tạo</span>
                    <span class="pet-info-value">
                        @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

            </div>

            <div class="pet-description">
                <span class="pet-info-label">Mô tả</span>

                <div class="pet-description-text">
                    @if (!string.IsNullOrEmpty(Model.MoTa))
                    {
                        @Model.MoTa
                    }
                    else
                    {
                        <span>Chưa có mô tả.</span>
                    }
                </div>
            </div>

        </div>

    </div>

</div>