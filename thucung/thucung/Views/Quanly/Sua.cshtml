@model thucung.Models.ThucungModel

@{
    Layout = null;
    ViewData["Title"] = "Sửa thú cưng";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #fffdf5;
        color: #3f3f3f;
    }

    .pet-edit-page {
        width: 100%;
        min-height: 100%;
        padding: 30px;
        background: radial-gradient(circle at 10% 10%, rgba(255, 218, 120, 0.18), transparent 25%), radial-gradient(circle at 90% 90%, rgba(255, 196, 87, 0.14), transparent 25%), #fffdf5;
    }

    .pet-edit-container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }

    .pet-edit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .pet-edit-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pet-edit-title-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        background: #ffd75e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        box-shadow: 0 6px 15px rgba(214, 166, 50, 0.18);
    }

    .pet-edit-title h1 {
        margin: 0;
        font-size: 25px;
        color: #3d3d3d;
    }

    .pet-edit-title p {
        margin: 5px 0 0;
        color: #888;
        font-size: 14px;
    }

    .pet-edit-card {
        background: white;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(86, 70, 20, 0.08);
        border: 1px solid #f4e8bd;
    }

    .pet-form {
        width: 100%;
    }

    .pet-form-message {
        margin-bottom: 22px;
        padding: 13px 16px;
        border-radius: 12px;
        background: #fff4f4;
        border: 1px solid #f1b8b8;
        color: #c43d3d;
        font-size: 14px;
        font-weight: 600;
    }

    .pet-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .pet-form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .pet-form-group.full {
            grid-column: 1 / -1;
        }

    .pet-form-label {
        font-size: 14px;
        font-weight: 600;
        color: #555;
    }

    .pet-form-input,
    .pet-form-select,
    .pet-form-textarea {
        width: 100%;
        border: 1px solid #e6ddc1;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 14px;
        outline: none;
        background: #fffef9;
        color: #444;
        transition: 0.2s;
    }

        .pet-form-input:focus,
        .pet-form-select:focus,
        .pet-form-textarea:focus {
            border-color: #e9bd3d;
            box-shadow: 0 0 0 3px rgba(233, 189, 61, 0.13);
        }

    .pet-form-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .pet-form-input[readonly] {
        background: #f8f5e9;
        color: #777;
        cursor: not-allowed;
    }

    .pet-image-current {
        margin-top: 10px;
        padding: 15px;
        border-radius: 15px;
        background: #fffaf0;
        border: 1px solid #f2e3b4;
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .pet-image-current img {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 13px;
            border: 2px solid #f2d26b;
            background: white;
        }

    .pet-image-name {
        font-size: 13px;
        color: #777;
        word-break: break-all;
    }

    .pet-form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #eee6ce;
    }

    .pet-back-button,
    .pet-save-button {
        border: none;
        border-radius: 12px;
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .pet-back-button {
        background: #f1eee3;
        color: #555;
    }

        .pet-back-button:hover {
            background: #e6e1d2;
            transform: translateY(-1px);
        }

    .pet-save-button {
        background: #ffd75e;
        color: #4b3d16;
        box-shadow: 0 5px 12px rgba(219, 175, 48, 0.18);
    }

        .pet-save-button:hover {
            background: #ffcd38;
            transform: translateY(-1px);
        }

        .pet-save-button:active,
        .pet-back-button:active {
            transform: scale(0.98);
        }

    .pet-code {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pet-code-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border-radius: 9px;
        background: #fff1bd;
        color: #80651c;
        font-size: 13px;
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .pet-edit-page {
            padding: 18px;
        }

        .pet-edit-card {
            padding: 20px;
        }

        .pet-form-grid {
            grid-template-columns: 1fr;
        }

        .pet-form-group.full {
            grid-column: auto;
        }

        .pet-edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .pet-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .pet-back-button,
        .pet-save-button {
            width: 100%;
        }
    }

    .pet-form-message {
        margin-bottom: 22px;
        padding: 13px 16px;
        border-radius: 12px;
        background: #fff4f4;
        border: 1px solid #f1b8b8;
        color: #c43d3d;
        font-size: 14px;
        font-weight: 600;
    }
</style>

<div class="pet-edit-page">

    <div class="pet-edit-container">

        <div class="pet-edit-header">

            <div class="pet-edit-title">

                <div class="pet-edit-title-icon">
                    🐾
                </div>

                <div>
                    <h1>Sửa thông tin thú cưng</h1>

                    <p>
                        Cập nhật thông tin cho thú cưng trong hệ thống K.M.N.A PET
                    </p>
                </div>

            </div>

            <div class="pet-code">

                <span>Mã thú cưng:</span>

                <span class="pet-code-badge">
                    @Model.MaThuCung
                </span>

            </div>

        </div>

        <div class="pet-edit-card">

            @if (ViewBag.tb != null && ViewBag.tb != "")
            {
                <div class="pet-form-message">
                    ⚠️ @ViewBag.tb
                </div>
            }

            <form asp-action="Suatc"
                  asp-controller="Quanly"
                  method="post"
                  enctype="multipart/form-data"
                  class="pet-form"
                  novalidate>

                <input type="hidden"
                       asp-for="MaThuCung" />

                <div class="pet-form-grid">

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Mã khách hàng
                        </label>

                        <select asp-for="MaKhachHang"
                                class="pet-form-select">

                            <option value="">
                                -- Chọn khách hàng --
                            </option>

                            @if (ViewBag.thongtinkhachhang != null)
                            {
                                foreach (var kh in ViewBag.thongtinkhachhang)
                                {
                                    <option value="@kh.MaKhachHang">
                                        @kh.MaKhachHang
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Tên thú cưng
                        </label>

                        <input asp-for="TenThuCung"
                               class="pet-form-input"
                               placeholder="Nhập tên thú cưng" />

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Loài thú cưng
                        </label>

                        <input asp-for="LoaiThuCung"
                               class="pet-form-input"
                               placeholder="Ví dụ: Chó, Mèo..." />

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Giống thú cưng
                        </label>

                        <input asp-for="GiongThuCung"
                               class="pet-form-input"
                               placeholder="Nhập giống" />

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Giới tính
                        </label>

                        <select asp-for="GioiTinh"
                                class="pet-form-select">

                            <option value="">
                                -- Chọn giới tính --
                            </option>

                            <option value="Đực">
                                Đực
                            </option>

                            <option value="Cái">
                                Cái
                            </option>

                        </select>

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Màu lông
                        </label>

                        <input asp-for="MauLong"
                               class="pet-form-input"
                               placeholder="Nhập màu lông" />

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Cân nặng
                        </label>

                        <input asp-for="CanNang"
                               type="number"
                               step="0.01"
                               class="pet-form-input"
                               placeholder="Nhập cân nặng" />

                    </div>

                    <div class="pet-form-group">

                        <label class="pet-form-label">
                            Ngày tạo
                        </label>

                        <input asp-for="NgayTao"
                               type="datetime-local"
                               class="pet-form-input" />

                    </div>

                    <div class="pet-form-group full">

                        <label class="pet-form-label">
                            Chọn ảnh mới
                        </label>

                        <input type="file"
                               class="pet-form-input"
                               name="anhFile"
                               accept="image/*" />

                        @if (!string.IsNullOrEmpty(Model.Anh))
                        {
                            <div class="pet-image-current">

                                <img src="~/images/@Model.Anh"
                                     alt="@Model.TenThuCung" />

                                <div class="pet-image-name">
                                    Ảnh hiện tại: @Model.Anh
                                </div>

                            </div>
                        }

                    </div>

                    <div class="pet-form-group full">

                        <label class="pet-form-label">
                            Mô tả
                        </label>

                        <textarea asp-for="MoTa"
                                  class="pet-form-textarea"
                                  placeholder="Nhập mô tả về thú cưng"></textarea>

                    </div>

                </div>

                <div class="pet-form-actions">

                    <button type="button"
                            class="pet-back-button"
                            data-page="@Url.Action("Thucung", "Quanly")">
                        ← Quay lại
                    </button>

                    <button type="submit"
                            class="pet-save-button">
                        💾 Lưu thay đổi
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>