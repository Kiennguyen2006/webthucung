@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NKK Pet - Intro</title>
    <link rel="stylesheet" href="~/css/intro.css" asp-append-version="true" />
    <!-- CDN Three.js chuẩn WebGL -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body class="intro-body">

    <div id="intro-world" 
         class="intro-world" 
         data-home-url="@Url.Action("Dangnhap", "Kiemtrathongtin")"
         data-bf1="@Url.Content("~/images/butterfly-1.png")"
         data-bf2="@Url.Content("~/images/butterfly-2.png")"
         data-bf3="@Url.Content("~/images/butterfly-3.png")">

        <canvas id="intro-canvas"></canvas>

        <div class="intro-brand" id="intro-brand">
            <h1 class="brand-title">NKK PET WORLD</h1>
            <p class="brand-subtitle">Thế Giới Thú Cưng Huyền Diệu</p>
        </div>

        <button type="button" class="intro-skip" id="intro-skip">
            <span>Bỏ qua</span>
            <svg class="skip-arrow" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-7.85-1.42 1.42 5.43 5.43H5v2z" />
            </svg>
        </button>

        <div class="intro-light-wash" id="light-wash"></div>
    </div>

    <script src="~/js/intro.js" asp-append-version="true"></script>
</body>
</html>